{
  "$schema": "https://raw.githubusercontent.com/nicolo-ribaudo/oxc-project.github.io/refs/heads/json-schema/src/public/.oxlintrc.schema.json",
  "jsPlugins": [
    { "name": "anti-slop", "specifier": "./script/oxlint/anti-slop/index.ts" },
    { "name": "anti-slop-effect", "specifier": "./script/oxlint/anti-slop/effect/index.ts" }
  ],
  "categories": {
    "correctness": "off",
    "suspicious": "off",
    "pedantic": "off",
    "perf": "off",
    "style": "off",
    "restriction": "off",
    "nursery": "off"
  },
  "rules": {
    "no-restricted-globals": [
      "error",
      {
        "name": "Reflect",
        "message": "Use typed property access or direct invocation. Suppress this rule only for genuine reflection."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "packages/app/**",
        "packages/desktop/**",
        "packages/gui-plugins/**",
        "packages/plugin/src/gui/**",
        "packages/ui/**",
        "packages/session-ui/**"
      ],
      "rules": {
        "oxc/no-accumulating-spread": "warn",
        "anti-slop/no-array-filter-map": "warn",
        "anti-slop/no-reduce-accumulator-copy": "warn",
        "anti-slop/no-chained-type-assertions": "warn",
        "anti-slop/no-conditional-empty-object-spread": "warn",
        "anti-slop/no-known-value-widening": "warn",
        "anti-slop/no-module-mocking": "warn",
        "anti-slop/no-object-parameters": "warn",
        "anti-slop/no-reflect-apply": "warn",
        "anti-slop/no-reflect-get": "warn",
        "anti-slop/no-runtime-typeof": "warn",
        "anti-slop/no-shape-in-symbol-names": "warn",
        "anti-slop/no-unknown-parameters": "warn",
        "anti-slop/no-unknown-returns": "warn",
        "anti-slop/no-unknown-type-aliases": "warn",
        "anti-slop/no-unsafe-dictionary-type": "warn",
        "anti-slop/no-widen-then-assert": "warn",
        "anti-slop/require-readable-spacing": "warn",
        "anti-slop/require-safety-comment-for-type-assertion": "warn"
      }
    },
    {
      "files": [
        "packages/app/**",
        "packages/desktop/**",
        "packages/gui-plugins/**",
        "packages/plugin/src/gui/**",
        "packages/session-ui/**"
      ],
      "rules": {
        "anti-slop-effect/no-manual-effect-error-tag": "warn",
        "anti-slop-effect/no-manual-tag-comparison": "warn",
        "anti-slop-effect/no-manual-tagged-construction": "warn",
        "anti-slop-effect/no-service-constructor-imports": "warn",
        "anti-slop-effect/prefer-effect-match": "warn"
      }
    },
    {
      "files": ["packages/gui-plugins/src/*.ts", "packages/gui-plugins/src/*.tsx"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "solid-js",
                "importNames": ["createEffect", "createRenderEffect", "createComputed"],
                "message": "GUI plugin code runs side effects through the SDK: createKeyed(source, fn, { otherwise }) per provider generation or value, createMemo or a plain function for derived values, createLatest for async data, createVisitState for per-visit state, and the handler for logic a user action causes. An escape hatch needs an oxlint-disable comment with a reason."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/gui-plugins/src/*/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "solid-js",
                "importNames": ["createEffect", "createRenderEffect", "createComputed"],
                "message": "GUI plugin code runs side effects through the SDK: createKeyed(source, fn, { otherwise }) per provider generation or value, createMemo or a plain function for derived values, createLatest for async data, createVisitState for per-visit state, and the handler for logic a user action causes. An escape hatch needs an oxlint-disable comment with a reason."
              }
            ],
            "patterns": [
              {
                "regex": "^@opencode/(app|desktop)(/|$)",
                "message": "GUI plugins never import the app or desktop packages. Use the SDK."
              },
              {
                "regex": "^@/",
                "message": "GUI plugins never import app internals. Use the SDK."
              },
              {
                "group": ["../*/*", "!../*/contract"],
                "message": "Import another built-in plugin only through its contract.ts."
              },
              {
                "regex": "\\.css$",
                "message": "Import CSS with ?inline and contribute it with ctx.add(Style, css)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/plugin/src/gui/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^@opencode/(app|desktop)(/|$)",
                "message": "The GUI SDK never imports the app or desktop packages; the hosts implement it."
              },
              {
                "regex": "^@opencode/gui-plugins(/|$)",
                "message": "The GUI SDK never imports the built-in plugins; they import the SDK."
              },
              {
                "regex": "^@/",
                "message": "The GUI SDK never imports app internals."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/codemode/src/interpreter/**", "packages/codemode/src/stdlib/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "effect",
                "allowTypeImports": true,
                "message": "The evaluator and built-ins are plain generators driven by the job queue in runner.ts. Start host work with runner.host or block on it with runner.blocking; only runner.ts, execute.ts, and extensions.ts run Effects."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "packages/codemode/src/interpreter/runner.ts",
        "packages/codemode/src/interpreter/execute.ts",
        "packages/codemode/src/interpreter/extensions.ts"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    },
    {
      "files": ["**/*.ts", "**/*.tsx", "**/*.js", "**/*.jsx", "**/*.mjs", "**/*.cjs", "**/*.mts", "**/*.cts"],
      "plugins": ["import"],
      "rules": {
        "import/no-namespace": "error"
      }
    },
    {
      "files": [
        "packages/ai/script/recording-cost-report.ts",
        "packages/ai/script/setup-recording-env.ts",
        "packages/ai/src/protocols/anthropic-messages.ts",
        "packages/ai/src/protocols/open-responses-channel.ts",
        "packages/ai/src/protocols/open-responses-continuation.ts",
        "packages/ai/src/protocols/openai-chat.ts",
        "packages/ai/src/protocols/openai-compatible-chat.ts",
        "packages/ai/src/protocols/openai-responses.ts",
        "packages/ai/src/providers/amazon-bedrock.ts",
        "packages/ai/src/providers/azure.ts",
        "packages/ai/src/providers/openai.ts",
        "packages/ai/src/route/client.ts",
        "packages/ai/src/route/transport/http.ts",
        "packages/ai/test/auth-options.types.ts",
        "packages/ai/test/auth.test.ts",
        "packages/ai/test/cache-policy.test.ts",
        "packages/ai/test/endpoint.test.ts",
        "packages/ai/test/generate-object.test.ts",
        "packages/ai/test/generation.test.ts",
        "packages/ai/test/http-timeout.test.ts",
        "packages/ai/test/lib/effect.ts",
        "packages/ai/test/lib/http.ts",
        "packages/ai/test/llm.test.ts",
        "packages/ai/test/loop-tools.types.ts",
        "packages/ai/test/provider/anthropic-messages-cache.recorded.test.ts",
        "packages/ai/test/provider/anthropic-messages.recorded.test.ts",
        "packages/ai/test/provider/freeform-tools.test.ts",
        "packages/ai/test/provider/gemini-cache.recorded.test.ts",
        "packages/ai/test/provider/gemini-openai-chat.recorded.test.ts",
        "packages/ai/test/provider/gemini.test.ts",
        "packages/ai/test/provider/golden.recorded.test.ts",
        "packages/ai/test/provider/openai-chat-reasoning.recorded.test.ts",
        "packages/ai/test/provider/openai-chat.test.ts",
        "packages/ai/test/provider/openai-compatible-chat.test.ts",
        "packages/ai/test/provider/openai-responses-cache.recorded.test.ts",
        "packages/ai/test/provider/openai-responses.test.ts",
        "packages/ai/test/provider/openrouter.test.ts",
        "packages/ai/test/provider/xai-responses.test.ts",
        "packages/ai/test/recorded-test.ts",
        "packages/ai/test/route.test.ts",
        "packages/ai/test/schema.test.ts",
        "packages/ai/test/tool-runtime.test.ts",
        "packages/ai/test/tool.types.ts",
        "packages/ai/test/transcription.test.ts",
        "packages/ai/test/video.test.ts",
        "packages/core/src/plugin/provider/claude-agent/claude/sdk.ts",
        "packages/core/test/tool-webfetch.test.ts",
        "packages/data/core/src/config.ts",
        "packages/data/core/src/database.ts",
        "packages/data/core/src/domain/geo.ts",
        "packages/data/core/src/domain/model.ts",
        "packages/data/core/src/domain/provider.ts",
        "packages/patchmark/test/fuzz.ts",
        "packages/tui/src/attention.ts",
        "packages/tui/src/component/dialog-go-upsell.tsx",
        "packages/tui/src/component/dialog-model-free.tsx",
        "packages/tui/src/component/dialog-model.tsx",
        "packages/tui/src/ui/dialog-select.tsx",
        "packages/tui/test/app-lifecycle.test.tsx",
        "packages/tui/test/context/storage.test.ts",
        "packages/ui/src/components/app-icon.stories.tsx",
        "packages/ui/src/components/collapsible.stories.tsx",
        "packages/ui/src/components/context-menu.stories.tsx",
        "packages/ui/src/components/favicon.stories.tsx",
        "packages/ui/src/components/file-icon.stories.tsx",
        "packages/ui/src/components/font.stories.tsx",
        "packages/ui/src/components/hover-card.stories.tsx",
        "packages/ui/src/components/image-preview.stories.tsx",
        "packages/ui/src/components/list.stories.tsx",
        "packages/ui/src/components/logo.stories.tsx",
        "packages/ui/src/components/popover.stories.tsx",
        "packages/ui/src/components/progress.stories.tsx",
        "packages/ui/src/components/provider-icon.stories.tsx",
        "packages/ui/src/components/resize-handle.stories.tsx",
        "packages/ui/src/components/sticky-accordion-header.stories.tsx",
        "packages/ui/src/components/text-field.stories.tsx",
        "packages/ui/src/components/typewriter.stories.tsx",
        "packages/util/src/cross-spawn-spawner.ts",
        "packages/util/src/effect/app-node-platform.ts",
        "packages/util/src/observability.ts",
        "sdks/vscode/src/extension.ts"
      ],
      "plugins": ["import"],
      "rules": {
        "import/no-namespace": "off"
      }
    }
  ],
  "ignorePatterns": [
    "**/node_modules",
    "**/dist",
    "**/.build",
    "**/.sst",
    "**/*.d.ts",
    "**/sdk.gen.ts",
    "packages/plugins/figma/skills/**",
    ".agent/**",
    ".agents/**",
    ".claude/**",
    ".codex/**",
    ".continue/**",
    ".cursor/**",
    ".gemini/**",
    ".opencode/**",
    ".pi/**",
    ".roo/**",
    ".windsurf/**",
    "script/oxlint/anti-slop/**",
    "services/site/public/arcade3d/basis/**",
    "services/site/public/arcade3d/draco/**"
  ]
}
